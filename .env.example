# Скопируйте в .env и подставьте свои значения.
# python -c "import secrets,base64; print(secrets.token_urlsafe(48)); print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"

APP_USERNAME=admin
APP_PASSWORD=changeme

# Подпись cookie-сессии (длинная случайная строка)
SESSION_SECRET=replace-with-long-random-string

# Ключ Fernet для токена Т-Банка (блок 1). Пока не используется.
FERNET_KEY=replace-with-fernet-key

# true — только если UI открывается по HTTPS
COOKIE_SECURE=false

# Через запятую, для npm run dev
CORS_ORIGINS=http://localhost:5173

TZ=Europe/Moscow

POSTGRES_USER=portfel
POSTGRES_PASSWORD=portfel
POSTGRES_DB=portfel

# Для uvicorn вне Docker (host = localhost). В compose подменяется на хост db.
DATABASE_URL=postgresql+asyncpg://portfel:portfel@localhost:5432/portfel

# Владелец GHCR: GitHub-логин или орг, строчными буквами
GHCR_OWNER=your-github-username
# Тег образов на VDS. Релизный pipeline подставляет sha; вручную можно latest
IMAGE_TAG=latest
